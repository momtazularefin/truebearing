# TrueBearing environment configuration
# Copy to .env and customize.

# PostgreSQL connection string (TimescaleDB)
DATABASE_URL=postgres://truebearing:truebearing@localhost:5432/truebearing?sslmode=disable

# Redis connection string
REDIS_URL=redis://localhost:6379/0

# HTTP server port
PORT=8080

# Log level: debug, info, warn, error
LOG_LEVEL=info
